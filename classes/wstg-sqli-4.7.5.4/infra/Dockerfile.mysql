# PolyRange — WSTG-ATHN-04 (4.4.4) SQL auth bypass — MySQL dialect.
# Real MariaDB + Node app in one container; the login query is concatenated
# straight against MySQL via `mysql2`.
FROM node:20-alpine
RUN apk add --no-cache mariadb mariadb-client
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install --omit=dev --no-audit --no-fund
COPY runtime/ ./runtime/
COPY classes/_shared/ ./classes/_shared/
COPY classes/wstg-sqli-4.7.5.4/scenario.mjs ./classes/wstg-sqli-4.7.5.4/scenario.mjs
COPY classes/wstg-sqli-4.7.5.4/behaviour.mjs ./classes/wstg-sqli-4.7.5.4/behaviour.mjs
COPY manifest.json ./manifest.json
COPY start-mysql.sh /start.sh
RUN chmod +x /start.sh
ENV MYSQL_URL=mysql://root:polyrange@127.0.0.1:3306/app
ENV PORT=8080
ENV NODE_ENV=production
EXPOSE 8080
CMD ["/start.sh"]
